{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/georgestephanis/p2026",
        "ref": "HEAD",
        "path": "/"
      },
      "options": {
        "activate": true,
        "targetFolderName": "p2026"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; include_once WP_PLUGIN_DIR . '/p2026/.github/setup.php';"
    }
  ]
}
