{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "p2-next",
  "version": "0.1.0",
  "description": "Modern P2/o2 replacement using the Block Editor and REST API.",
  "scripts": {
    "build": "WP_BLOCKS_MANIFEST=true wp-scripts build --output-path=build",
