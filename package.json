{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "p2026",
  "version": "0.1.0",
  "description": "Modern P2/o2 replacement using the Block Editor and REST API.",
  "files": [
    "admin",
    "build",
    "includes",
    "modules",
    "languages",
    "public",
    "p2026.php",
    "uninstall.php",
    "block.json",
    "README.md",
    "readme.txt",
    "CHANGELOG.md",
    "LICENSE",
    "license.txt"
  ],
  "scripts": {
    "build": "wp-scripts build --blocks-manifest",
    "start": "wp-scripts start --blocks-manifest",
    "lint": "npm run lint:js; npm run lint:css; npm run lint:php",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "lint:php": "composer lint:php",
    "format": "npm run format:js; npm run format:css; npm run format:php",
    "format:js": "wp-scripts lint-js --fix",
    "format:css": "wp-scripts lint-style --fix",
    "format:php": "composer format:php",
    "plugin-zip": "wp-scripts plugin-zip"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0"
  },
  "license": "GPL-2.0-or-later"
}
