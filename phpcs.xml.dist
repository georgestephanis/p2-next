<?xml version="1.0"?>
<ruleset name="P2 Next">
	<description>PHP CodeSniffer rules for the p2-next plugin.</description>

	<!-- What to scan -->
	<file>p2-next.php</file>
	<file>src/blocks/new-post/render.php</file>

	<!-- Ignore build artefacts and third-party code -->
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>

	<rule ref="WordPress">
		<!-- Plugin doesn't use a custom table prefix -->
		<exclude name="WordPress.DB.SlowDBQuery"/>
	</rule>

	<!-- Enforce WordPress file naming conventions -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="false"/>
		</properties>
	</rule>

	<!-- Minimum PHP version to target -->
	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="p2-next"/>
			</property>
		</properties>
	</rule>
</ruleset>
